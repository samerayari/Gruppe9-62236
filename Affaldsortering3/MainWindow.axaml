<!--
Fil: MainWindow.axaml
Dette er GUI-designet (layoutet) for hele programmet.
Her bestemmer vi hvad der vises på skærmen: login-side, faner og knapper.
Knapperne kalder metoder i MainWindow.axaml.cs (fx Login_Click, RunRobot_Click osv.)
-->

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Affaldsortering3"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
        x:Class="Affaldsortering3.MainWindow"
        x:DataType="local:MainWindow"
        Title="SystemLogin">

    <!--
    Hoved-grid: 2 rækker
    Row 0 = top bar (titel + knapper)
    Row 1 = alt indhold (login eller app)
    -->
    <Grid RowDefinitions="Auto,*" Margin="16">

        <!-- Top bar -->
        <!--
        Øverst: Titel til venstre og knapper til højre
        Logout vises kun når man er logget ind
        Clear log vises kun når man er admin
        -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="Bold" Text="Robot Sorting System" DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Logout" Click="Logout_Click" IsVisible="{Binding IsLoggedIn}"/>
                <Button Content="Clear log" Click="ClearLog_Click" IsVisible="{Binding IsAdmin}"/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- LOGIN VIEW -->
            <!--
            Denne del er login-skærmen.
            Den vises når ShowLogin = true (altså når man IKKE er logget ind).
            TextBox felterne er bundet til LoginUsername og LoginPassword i MainWindow.cs
            -->
            <Border IsVisible="{Binding ShowLogin}" Padding="18" CornerRadius="8" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="26" Text="Login" FontWeight="Bold"/>
                    <TextBlock Text="Username"/>
                    <TextBox Text="{Binding LoginUsername}"/>
                    <TextBlock Text="Password"/>
                    <TextBox Text="{Binding LoginPassword}" PasswordChar="●"/>
                    <Button Content="Login" Click="Login_Click" Width="160"/>
                    <!-- Her vises fejl hvis login ikke virker -->
                    <TextBlock Text="{Binding LoginError}" Foreground="Red"/>
                </StackPanel>
            </Border>

            <!-- APP VIEW -->
            <!--
            Denne del er selve programmet.
            Den vises når ShowApp = true (altså når man ER logget ind).
            Indeholder faner (TabControl).
            -->
            <Border IsVisible="{Binding ShowApp}" Padding="0" CornerRadius="8">
                <TabControl>

                    <!-- Robot -->
                    <!--
                    Robot-fanen: her kan man styre robotten.
                    Knapperne kalder metoder i MainWindow.axaml.cs:
                    RunRobot_Click, PowerOn_Click, BrakeRelease_Click, Stop_Click, EmergencyStop_Click
                    RobotStatus viser tekst fra variablen RobotStatus i MainWindow.cs
                    -->
                    <TabItem Header="Robot">
                        <StackPanel Margin="12" Spacing="10">
                            <TextBlock FontSize="22" FontWeight="Bold" Text="Robot kontrol"/>
                            <TextBlock Text="Her kan du starte robot-programmet."/>

                            <Button Content="Start Robot" Click="RunRobot_Click" Width="320"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Power On" Click="PowerOn_Click" Width="120"/>
                                <Button Content="Brake Release" Click="BrakeRelease_Click" Width="140"/>
                            </StackPanel>

                            <!-- NYE knapper -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Stop" Click="Stop_Click" Width="120"/>
                                <Button Content="EMERGENCY STOP" Click="EmergencyStop_Click" Width="180"/>
                            </StackPanel>

                            <TextBlock Text="{Binding RobotStatus}" />
                        </StackPanel>
                    </TabItem>

                    <!-- Users (kun admin) -->
                    <!--
                    Users-fanen er kun synlig for admin (IsVisible={Binding IsAdmin}).
                    Her kan admin oprette nye brugere:
                    Felterne er bundet til NewUserUsername, NewUserPassword og NewUserIsAdmin i MainWindow.cs
                    Create user knappen kalder CreateUser_Click i MainWindow.axaml.cs
                    -->
                    <TabItem Header="Users" IsVisible="{Binding IsAdmin}">
                        <Grid Margin="12" RowDefinitions="Auto,Auto,*" ColumnDefinitions="2*,3*"
                              ColumnSpacing="14" RowSpacing="10">

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                       FontSize="22" FontWeight="Bold"
                                       Text="Create user (Admin)"/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                                <TextBlock Text="Username"/>
                                <TextBox Text="{Binding NewUserUsername}"/>
                                <TextBlock Text="Password"/>
                                <TextBox Text="{Binding NewUserPassword}" PasswordChar="●"/>
                                <CheckBox Content="Is Admin?" IsChecked="{Binding NewUserIsAdmin}"/>
                                <Button Content="Create user" Click="CreateUser_Click" Width="160"/>
                                <!-- Her vises fejl hvis bruger ikke kan oprettes -->
                                <TextBlock Text="{Binding UserCreateError}" Foreground="Red"/>
                            </StackPanel>

                            
                        </Grid>
                    </TabItem>

                    <!-- Database (kun admin) - LOG -->
                    <!--
                    Database-fanen er også kun synlig for admin.
                    Den viser en log (UiLog), som er en liste af tekst-linjer.
                    ScrollViewer gør at man kan scrolle op/ned i historikken.
                    -->
                    <TabItem Header="Database" IsVisible="{Binding IsAdmin}">
                        <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="12">

                            <TextBlock Grid.Row="0"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Text="Systemhistorik"/>

                            <Border Grid.Row="1" Padding="10" CornerRadius="8" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding UiLog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>

        </Grid>
    </Grid>
</Window>



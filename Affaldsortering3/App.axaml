<!--
Denne fil bestemmer hvordan appen ser ud.
Den kører automatisk, når man trykker Run i Rider.
-->

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

            
             x:Class="Affaldsortering3.App"

            
             RequestedThemeVariant="Default">

    <!-- Her vælger vi appens udseende -->
    <Application.Styles>

        <!-- Giver appen et moderne Windows-look -->
        <FluentTheme />

    </Application.Styles>
</Application>